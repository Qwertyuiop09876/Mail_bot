# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Все переменные имеют префикс MAILBOT_.

# База данных. По умолчанию — SQLite-файл в ./data (создаётся автоматически).
# MAILBOT_DATABASE_URL=sqlite:///data/mailbot.db

# ОБЯЗАТЕЛЬНО. Ключ шифрования паролей SMTP/IMAP и подписи ссылок отписки.
# Сгенерировать:  mailbot gen-key
# Потеряете ключ — придётся заново ввести пароли ящиков; смените ключ — старые ссылки отписки перестанут работать.
MAILBOT_SECRET_KEY=

# Публичный HTTPS-адрес, по которому доступен сервер отписок (mailbot serve-unsubscribe за nginx/Caddy).
# Ссылка в письме будет вида <BASE_URL>/<токен>. Без него отправка кампаний запрещена.
# MAILBOT_UNSUBSCRIBE_BASE_URL=https://mail.example.com/unsubscribe

# Часовой пояс для времени без указания зоны (например, при планировании).
# MAILBOT_TIMEZONE=Europe/Moscow

# Воркер
# MAILBOT_POLL_INTERVAL_SECONDS=5
# MAILBOT_MAX_ATTEMPTS=3
# MAILBOT_RETRY_BASE_SECONDS=300
# MAILBOT_SMTP_TIMEOUT_SECONDS=30
# MAILBOT_LOG_LEVEL=INFO
